<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="3dp" />
            <corners android:radius="2dp" />
            <solid android:color="#38FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="3dp" />
                <corners android:radius="2dp" />
                <solid android:color="#66FFFFFF" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="3dp" />
                <corners android:radius="2dp" />
                <solid android:color="#D4AF37" />
            </shape>
        </clip>
    </item>
</layer-list>
