<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Direct-Touch Draggable & Pinch-Zoomable Subtitle Overlay -->
    <TextView
        android:id="@+id/tvDraggableSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="46dp"
        android:background="#8C000000"
        android:elevation="18dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tall Vertical Volume & Brightness Pill Slider (Flagship Cinema Style) -->
    <LinearLayout
        android:id="@+id/verticalSliderCard"
        android:layout_width="62dp"
        android:layout_height="214dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:background="#E6090D16"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVerticalSliderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🔊"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/verticalBarTrack"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="#2EFFFFFF">

            <View
                android:id="@+id/verticalBarFill"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="#38BDF8" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVerticalSliderPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Toast / Gesture Indicator (Seek / Speed / Sync) -->
    <TextView
        android:id="@+id/tvGestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0F172A"
        android:elevation="20dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="#38BDF8"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Loading Indicator for Subtitle Search / Network Stream -->
    <ProgressBar
        android:id="@+id/playerLoadingBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:elevation="22dp"
        android:indeterminateTint="#38BDF8"
        android:visibility="gone" />

    <!-- Unlock Button when screen is locked -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#CC0F172A"
        android:contentDescription="@string/unlock"
        android:elevation="20dp"
        android:padding="12dp"
        android:src="@drawable/ic_lock_modern"
        android:tint="#38BDF8"
        android:visibility="gone" />

    <!-- Player Controls Container -->
    <FrameLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/playerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#D9090D16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnClosePlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_close_modern"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Video"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSubSyncMinus"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:minWidth="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="-0.1s"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSubSyncPlus"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="+0.1s"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSubFontDown"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:minWidth="38dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="A-"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSubFontUp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:minWidth="38dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="A+"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetSubPos"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="38dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="🎯"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOrientation"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="58dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/orientation_landscape"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pro_pip"
                android:src="@drawable/ic_pip_modern"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnMorePro"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pro_tools_title"
                android:src="@drawable/ic_settings_gear"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Bar (Forced LTR so timeline & transport controls never flip in Arabic) -->
        <LinearLayout
            android:id="@+id/playerBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#D9090D16"
            android:layoutDirection="ltr"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layoutDirection="ltr"
                    android:max="1000" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lock"
                    android:src="@drawable/ic_lock_modern"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSubtitles"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/subtitles"
                    android:src="@drawable/ic_subtitles_cc"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnAudioTrack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/audio_tracks"
                    android:src="@drawable/ic_audio_track_modern"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rewind_15"
                    android:src="@drawable/ic_rewind_10_modern"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play_pause"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_modern"
                    android:tint="#38BDF8" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/forward_15"
                    android:src="@drawable/ic_forward_10_modern"
                    android:tint="#FFFFFF" />

                <Button
                    android:id="@+id/btnSpeed"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="54dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1.0x"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAspectRatio"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/aspect_ratio"
                    android:src="@drawable/ic_aspect_ratio_modern"
                    android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
