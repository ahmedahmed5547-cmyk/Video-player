<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:layoutDirection="locale">

    <!-- LibVLC Video Surface -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Direct-Touch Fluid Draggable & Pinch-Zoomable Subtitle View -->
    <TextView
        android:id="@+id/tvDraggableSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:background="#AA000000"
        android:gravity="center"
        android:maxWidth="680dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textColor="@color/white"
        android:textDirection="anyRtl"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Non-Blocking Loading Indicator for Coroutine Subtitle Search -->
    <ProgressBar
        android:id="@+id/playerLoadingBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:indeterminateTint="@color/accent_blue"
        android:visibility="gone" />

    <!-- Center Gesture Feedback Indicator -->
    <TextView
        android:id="@+id/tvGestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/overlay_dark"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Unlock Button -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@color/overlay_dark"
        android:contentDescription="@string/unlock_button_desc"
        android:padding="12dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:visibility="gone"
        app:tint="@color/accent_blue" />

    <!-- Main Player Controls Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar (Follows App Locale Direction) -->
        <LinearLayout
            android:id="@+id/playerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay_dark"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnClosePlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_button_desc"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubFontUp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="A+"
                android:textColor="@color/accent_blue"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubFontDown"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="A-"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- On-Screen Subtitle Sync (-100ms / +100ms) & Reset Position Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubSyncMinus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="-0.1s"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubSyncPlus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="+0.1s"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetSubPos"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"
                android:text="🎯"
                android:textColor="@color/accent_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubtitles"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitles"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioTrack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_tracks"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="@color/accent_blue" />

            <ImageButton
                android:id="@+id/btnMorePro"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_pro_options"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Bottom Bar: Strictly LTR so SeekBar & Playback Transport Controls never flip backwards in RTL -->
        <LinearLayout
            android:id="@+id/playerBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay_dark"
            android:layoutDirection="ltr"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Seek Bar Row (Strictly LTR) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:layoutDirection="ltr"
                    android:max="1000" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Transport Controls Row (Strictly LTR) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lock_screen"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrientation"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/orientation_auto"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toast_rewind_15"
                    android:src="@android:drawable/ic_media_rew"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play/Pause"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@color/accent_blue" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toast_forward_15"
                    android:src="@android:drawable/ic_media_ff"
                    app:tint="@color/white" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPip"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pip_button"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAspectRatio"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aspect_ratio"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
