<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Dedicated VLC Video & Subtitle Surface Container (Official VLC-for-Android architecture) -->
    <FrameLayout
        android:id="@+id/videoSurfaceFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:foregroundGravity="clip_horizontal|clip_vertical">

        <SurfaceView
            android:id="@+id/videoSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <SurfaceView
            android:id="@+id/subtitlesSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Direct-Touch Draggable & Pinch-Zoomable Subtitle Overlay -->
    <TextView
        android:id="@+id/tvDraggableSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="46dp"
        android:background="#8C000000"
        android:elevation="18dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tall Vertical Volume & Brightness Pill Slider (Flagship Cinema Style) -->
    <LinearLayout
        android:id="@+id/verticalSliderCard"
        android:layout_width="62dp"
        android:layout_height="214dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:background="#E6090D16"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVerticalSliderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🔊"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/verticalBarTrack"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="#2EFFFFFF">

            <View
                android:id="@+id/verticalBarFill"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="#38BDF8" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVerticalSliderPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Toast / Gesture Indicator (Seek / Speed / Sync) -->
    <TextView
        android:id="@+id/tvGestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0F172A"
        android:elevation="20dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="#38BDF8"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Loading Indicator for Subtitle Search / Network Stream -->
    <ProgressBar
        android:id="@+id/playerLoadingBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:elevation="22dp"
        android:indeterminateTint="#38BDF8"
        android:visibility="gone" />

    <!-- Unlock Button when screen is locked -->
    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#CC0F172A"
        android:contentDescription="@string/unlock"
        android:elevation="20dp"
        android:padding="12dp"
        android:src="@drawable/ic_lock_modern"
        android:tint="#38BDF8"
        android:visibility="gone" />

    <!-- Player Controls Container -->
    <FrameLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/playerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_player_top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/player_top_bar_padding_horizontal"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/player_top_bar_padding_horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnClosePlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_close_modern"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Video"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- Single Compact Luxury Glass Pill Group for Subtitle Controls -->
            <LinearLayout
                android:id="@+id/subtitleToolsPill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_luxury_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/btnSubSyncMinus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="42dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="-0.1s"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubSyncPlus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="42dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="+0.1s"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="#26FFFFFF" />

                <Button
                    android:id="@+id/btnSubFontDown"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="A-"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubFontUp"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="A+"
                    android:textAllCaps="false"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResetSubPos"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="◎"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDecoder"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="HW+"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOrientation"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="58dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/orientation_landscape"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSleepTimerBadge"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_luxury_glass_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="15:00"
                android:textColor="#D4AF37"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSleepTimer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sleep_timer_title"
                android:src="@drawable/ic_sleep_timer"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnAudioOnly"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/audio_only_mode_title"
                android:src="@drawable/ic_headphones"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnCastScreen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cast_screen_title"
                android:src="@drawable/ic_cast_modern"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pro_pip"
                android:src="@drawable/ic_pip_modern"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnMorePro"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pro_tools_title"
                android:src="@drawable/ic_settings_gear"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Bar: ConstraintLayout with centered transport group + tidy start/end tool groups -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_player_bottom_scrim"
            android:layoutDirection="ltr"
            android:paddingStart="@dimen/player_bottom_bar_padding_horizontal"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/player_bottom_bar_padding_horizontal"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/seekBarRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layoutDirection="ltr"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/bg_luxury_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_luxury_seekbar_thumb" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Start Secondary Tools Group: Lock, Subtitles, Audio Track -->
            <LinearLayout
                android:id="@+id/leftToolsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/transportGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/transportGroup">

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="@dimen/player_action_btn_size"
                    android:layout_height="@dimen/player_action_btn_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lock"
                    android:src="@drawable/ic_lock_modern"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSubtitles"
                    android:layout_width="@dimen/player_action_btn_size"
                    android:layout_height="@dimen/player_action_btn_size"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/subtitles"
                    android:src="@drawable/ic_subtitles_cc"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnAudioTrack"
                    android:layout_width="@dimen/player_action_btn_size"
                    android:layout_height="@dimen/player_action_btn_size"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/audio_tracks"
                    android:src="@drawable/ic_audio_track_modern"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Centered Main Transport Group: Rewind / Play-Pause / Forward -->
            <LinearLayout
                android:id="@+id/transportGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seekBarRow">

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="@dimen/player_transport_btn_size"
                    android:layout_height="@dimen/player_transport_btn_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rewind_15"
                    android:src="@drawable/ic_rewind_10_modern"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="@dimen/player_play_btn_size"
                    android:layout_height="@dimen/player_play_btn_size"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play_pause"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_modern"
                    android:tint="#38BDF8" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="@dimen/player_transport_btn_size"
                    android:layout_height="@dimen/player_transport_btn_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/forward_15"
                    android:src="@drawable/ic_forward_10_modern"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <!-- End Secondary Tools Group: Speed, Aspect Ratio -->
            <LinearLayout
                android:id="@+id/rightToolsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/transportGroup"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/transportGroup">

                <Button
                    android:id="@+id/btnSpeed"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="52dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1.0x"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAspectRatio"
                    android:layout_width="@dimen/player_action_btn_size"
                    android:layout_height="@dimen/player_action_btn_size"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/aspect_ratio"
                    android:src="@drawable/ic_aspect_ratio_modern"
                    android:tint="#FFFFFF" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>
