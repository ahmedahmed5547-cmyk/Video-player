<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

        <!-- Contextual Selection Mode Top Bar (RTL-safe, Main Library & Vault) -->
    <LinearLayout
        android:id="@+id/selectionTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:background="#1A2438"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnSelectionClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSelectionSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/selection_select_all"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSelectionOverflow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/selection_more_actions"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:background="#131C2E"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/top_bar_padding_horizontal"
        android:paddingEnd="@dimen/top_bar_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackFolder"
            android:layout_width="@dimen/top_action_btn_size"
            android:layout_height="@dimen/top_action_btn_size"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back_modern"
            android:tint="#38BDF8"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/toolbarTitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/toolbar_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolbarSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_subtitle"
                android:textAlignment="viewStart"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleSearch"
            android:layout_width="@dimen/top_action_btn_size"
            android:layout_height="@dimen/top_action_btn_size"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_videos_hint"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search_modern"
            android:tint="#38BDF8" />

        <ImageButton
            android:id="@+id/btnTopMenu"
            android:layout_width="@dimen/top_action_btn_size"
            android:layout_height="@dimen/top_action_btn_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/top_menu_content_desc"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_hamburger"
            android:tint="#38BDF8" />

        <!-- Hidden legacy buttons preserved for binding compatibility -->
        <ImageButton
            android:id="@+id/btnSortAndLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/sort_and_layout_title"
            android:src="@drawable/ic_layout_sort_modern"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnOpenFile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/open_external_file"
            android:src="@drawable/ic_folder_open_modern"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/settings_header"
            android:src="@drawable/ic_settings_gear"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#131C2E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/top_bar_padding_horizontal"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/top_bar_padding_horizontal"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <EditText
            android:id="@+id/etSearchVideos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="@string/search_videos_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="14.5sp" />

        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="@dimen/top_action_btn_size"
            android:layout_height="@dimen/top_action_btn_size"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_modern"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- IPTV Sub-Header Bar + Subtle Background Sync Indicator + Section Sub-Tabs -->
    <LinearLayout
        android:id="@+id/iptvHeaderBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#0E1525"
        android:orientation="vertical"
        android:paddingStart="@dimen/top_bar_padding_horizontal"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/top_bar_padding_horizontal"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer">

        <!-- Subtle, non-intrusive top progress line for background IPTV synchronization -->
        <ProgressBar
            android:id="@+id/iptvSubtleSyncBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginBottom="6dp"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/iptvInlineSyncSpinner"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="true"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvIptvStatusSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/iptv_sources_subtitle"
                android:textAlignment="viewStart"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/btnAddIptvSourceBar"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:contentDescription="@string/iptv_add_source_title"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivAddIptvPlus"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_plus_circle"
                    android:tint="#38BDF8" />

                <TextView
                    android:id="@+id/tvAddIptvBarLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/iptv_add_source_short"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sub-Tabs inside Series / Movies / Live TV: All Categories | Favorites ❤️ | History & Continue Watching ⏱️ -->
        <LinearLayout
            android:id="@+id/iptvSubTabsBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/iptv_subtab_height"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnIptvSubTabAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/iptv_subtab_all"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/iptv_subtab_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnIptvSubTabFav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/iptv_subtab_favorites"
                android:textColor="#94A3B8"
                android:textSize="@dimen/iptv_subtab_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnIptvSubTabRecent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/iptv_subtab_recent"
                android:textColor="#94A3B8"
                android:textSize="@dimen/iptv_subtab_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iptvHeaderBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/recycler_horizontal_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/recycler_horizontal_padding"
            android:paddingBottom="88dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/emptyLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iptvHeaderBar">

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_videos_found"
            android:textColor="#CBD5E1"
            android:textSize="15.5sp" />

        <ProgressBar
            android:id="@+id/libraryLoadingBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_permission" />

        <Button
            android:id="@+id/btnRefreshEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/refresh_library"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Subtle Compact Spinner Overlay (Text hidden by default; no "Connecting to Servers" message) -->
    <LinearLayout
        android:id="@+id/iptvLoadingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ProgressBar
            android:id="@+id/iptvProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/tvIptvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/iptv_loading_data"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabResumeLast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/resume_last"
        android:src="@drawable/ic_play_modern"
        android:visibility="gone"
        app:backgroundTint="#38BDF8"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:fabCustomSize="50dp"
        app:maxImageSize="24dp"
        app:tint="#090D16"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent" />


        <!-- Dedicated IPTV RecyclerView kept alive across tab switches (eliminates Video <-> IPTV stutter & folder flash) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iptvRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/recycler_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/recycler_horizontal_padding"
        android:paddingBottom="88dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iptvHeaderBar" />

    <!-- In-Place Audio Library Tab (hosted above persistent bottomNavBar so bottom bar never hides or flickers) -->
    <LinearLayout
        android:id="@+id/audioTabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/audioSubTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <EditText
            android:id="@+id/etAudioTabSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/audio_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAudioTabStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="14.5sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/audioTabListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:clipToPadding="false"
            android:paddingBottom="72dp" />
    </LinearLayout>

    <!-- Persistent Background Audio / Audio-Only Mini Player Bar -->
    <LinearLayout
        android:id="@+id/miniAudioPlayerBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#E612121A"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivMiniAudioIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_headphones"
            android:tint="#D4AF37" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMiniAudioTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="VEXO Player"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMiniAudioSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Audio Only"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMiniReturnVideo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/return_to_video"
            android:src="@drawable/ic_lux_play_engine"
            android:tint="#D4AF37"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_pause_modern"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnMiniNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward_15"
            android:src="@drawable/ic_forward_10_modern"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnMiniClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close_modern"
            android:tint="#94A3B8" />
    </LinearLayout>

    <!-- Bottom Navigation Bar: Material 3 Icon-Only (Video, Audio, Private, IPTV) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:minHeight="60dp"
        android:background="#131C2E"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/tabVideos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tab_video_folders">

            <View
                android:id="@+id/pillTabVideos"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/ivTabVideos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_video_filled"
                android:tint="#38BDF8" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabAudio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tab_audio">

            <View
                android:id="@+id/pillTabAudio"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/ivTabAudio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_audio_outlined"
                android:tint="#94A3B8" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tab_vault">

            <View
                android:id="@+id/pillTabVault"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/ivTabVault"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_private_outlined"
                android:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvVaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:minWidth="16dp"
                android:layout_gravity="center"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#090D16"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabIptv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tab_iptv_compact">

            <View
                android:id="@+id/pillTabIptv"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/ivTabIptv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_iptv_outlined"
                android:tint="#94A3B8" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
